# GEMINI_API_KEY: Required for Gemini AI API calls and Speech-to-Text smart transcription.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL / Supabase / Embedded SQLite fallback)
DATABASE_URL=

# JWT Secrets for Access and Refresh tokens
JWT_ACCESS_SECRET="zen_security_jwt_access_secret_super_secure_key_2026"
JWT_REFRESH_SECRET="zen_security_jwt_refresh_secret_super_secure_key_2026"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Speech-to-text API Key
SPEECH_TO_TEXT_API_KEY=

